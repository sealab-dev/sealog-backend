# ==============================================================================
# Sealog Backend Environment Variables Template
# 복사하여 .env 파일을 생성한 뒤 환경에 맞게 수정하여 사용하세요.
# ==============================================================================

# ── Spring ──────────────────────────────────────────────────────────────────
# 활성 프로필 (dev, prod)
SPRING_PROFILES_ACTIVE=dev

# 서버 포트
SERVER_PORT=8080

# 스케줄러 활성화 여부
SCHEDULER_ENABLED=true

# ── Storage Strategy ────────────────────────────────────────────────────────
# 스토리지 타입 (local, s3)
STORAGE_TYPE=local

# ── Database (MariaDB) ──────────────────────────────────────────────────────
DATABASE_URL=jdbc:mariadb://localhost:3306/devdb
DATABASE_USER=devuser
DATABASE_PASSWORD=devpass

# JPA 설정
JPA_SHOW_SQL=true
JPA_HIBERNATE_DDL=update

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Authentication (JWT) ────────────────────────────────────────────────────
# HS256 알고리즘 사용 시 최소 32자 이상의 비밀키 권장
JWT_KEY=local_development_secret_key_at_least_32_characters_long

# 만료 시간 (ms) - Access: 1시간, Refresh: 7일
JWT_ACCESS_TTL=3600000
JWT_REFRESH_TTL=604800000

# ── App & Security ──────────────────────────────────────────────────────────
FRONT_ORIGIN=http://localhost:5173
COOKIE_IS_SECURE=false
COOKIE_SAMESITE=Lax

# ── AWS S3 & CloudFront (STORAGE_TYPE=s3 일 때 필수) ────────────────────────
AWS_ACCESS_KEY=your_access_key
AWS_SECRET_KEY=your_secret_key
AWS_REGION=ap-northeast-2
AWS_BUCKET=your-bucket-name
AWS_DOMAIN=your-cloudfront-domain.cloudfront.net
AWS_DISTRIBUTION_ID=your_distribution_id

# ── Local File Storage (STORAGE_TYPE=local 일 때 사용) ──────────────────────
FILE_UPLOAD_DIR=./uploads
FILE_BASE_URL=http://localhost:8080/files


# ── Logging ─────────────────────────────────────────────────────────────────
# 로그 파일 경로 (비워두면 콘솔에만 출력)
LOG_FILE_PATH=
